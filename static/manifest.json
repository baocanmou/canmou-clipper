{
	"manifest_version": 3,
	"name": "参谋剪藏",
	"short_name": "参谋剪藏",
	"version": "0.0.0",
	"description": "把网页存进 Obsidian，由 Jev 判断该归到哪个目录、打什么标签。附带去干扰的中文阅读模式。",
	"homepage_url": "https://github.com/baocanmou/canmou-clipper",
	"permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
	"host_permissions": ["https://api.typesafe.ai/*"],
	"action": {
		"default_popup": "popup.html",
		"default_title": "参谋剪藏"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": { "default": "Alt+Shift+S" },
			"description": "打开参谋剪藏"
		},
		"toggle-reader": {
			"suggested_key": { "default": "Alt+Shift+R" },
			"description": "进入或退出阅读模式"
		}
	}
}
